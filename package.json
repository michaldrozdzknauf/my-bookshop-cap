{
  "name": "my-bookshop",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/my-bookshop.sqlite"
        }
      }
    },
    "fiori": {
      "preview": true
    },
    "server": {
      "index": true
    }
  }
}
